rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'displayName', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.email is string && data.email.size() <= 256 &&
        data.role is string && (data.role == 'Freelancer' || data.role == 'Client' || data.role == 'Admin') &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['id', 'clientId', 'title', 'description', 'roleCategory', 'status', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 5000 &&
        data.roleCategory is string && data.roleCategory.size() <= 60 &&
        data.status is string && (data.status == 'Open' || data.status == 'Closed' || data.status == 'Filled') &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['id', 'jobId', 'freelancerId', 'status', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.jobId is string && data.jobId.size() <= 128 &&
        data.freelancerId is string && data.freelancerId.size() <= 128 &&
        data.status is string && (data.status == 'Submitted' || data.status == 'Accepted' || data.status == 'Declined' || data.status == 'Withdrawn') &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidContract(data) {
      return data.keys().hasAll(['id', 'clientId', 'freelancerId', 'status', 'contractValueMinor', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.freelancerId is string && data.freelancerId.size() <= 128 &&
        data.status is string && (data.status == 'Active' || data.status == 'Completed' || data.status == 'Cancelled' || data.status == 'Disputed') &&
        data.contractValueMinor is number && data.contractValueMinor > 0 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['id', 'contractId', 'title', 'contractValueMinor', 'state', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.contractId is string && data.contractId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.contractValueMinor is number && data.contractValueMinor > 0 &&
        data.state is string && (data.state == 'Unfunded' || data.state == 'Funded' || data.state == 'InProgress' || data.state == 'Submitted' || data.state == 'ApprovedReleased' || data.state == 'Disputed') &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidLedgerEntry(data) {
      return data.keys().hasAll(['id', 'milestoneId', 'type', 'amountMinor', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.milestoneId is string && data.milestoneId.size() <= 128 &&
        data.type is string && (data.type == 'EscrowFund' || data.type == 'FreelancerPayout' || data.type == 'ClientFee' || data.type == 'FreelancerFee' || data.type == 'EscrowRefund') &&
        data.amountMinor is number && data.amountMinor > 0 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Rules for Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if false; // Disallow querying across all users
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'freelancerProfileId', 'clientProfileId', 'isFullyVerified']);
      allow delete: if false;
    }

    // Rules for Freelancer Profiles
    match /freelancerProfiles/{profileId} {
      allow get, list: if true; // Public marketplace profile lookup
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(profileId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'headline', 'bio', 'primaryRole', 'rateBand',
          'experienceLevel', 'hourlyRateMinor', 'panStatus', 'aadhaarStatus',
          'epfStatus', 'isFullyVerified', 'panNumber', 'aadhaarLast4', 'epfUan'
        ]);
      allow delete: if false;
    }

    // Rules for Client Profiles
    match /clientProfiles/{profileId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(profileId);
      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'gstin', 'plan']);
      allow delete: if false;
    }

    // Rules for Jobs
    match /jobs/{jobId} {
      allow get, list: if true; // Open talent directory and marketplace job listings
      allow create: if isSignedIn() && isValidId(jobId) && isValidJob(incoming());
      allow update: if isSignedIn() && isValidId(jobId) && isValidJob(incoming()) &&
        incoming().id == existing().id &&
        incoming().clientId == existing().clientId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'roleCategory', 'channel', 'status', 'budgetMinorMin', 'budgetMinorMax', 'updatedAt']);
      allow delete: if false;
    }

    // Rules for Proposals
    match /proposals/{proposalId} {
      allow get: if isSignedIn() && (resource.data.freelancerId == request.auth.uid || resource.data.freelancerId == request.auth.token.email);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(proposalId) && isValidProposal(incoming());
      allow update: if isSignedIn() && isValidId(proposalId) && isValidProposal(incoming()) &&
        incoming().id == existing().id &&
        incoming().jobId == existing().jobId &&
        incoming().freelancerId == existing().freelancerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'coverNote', 'proposedRateMinor']);
      allow delete: if false;
    }

    // Rules for Contracts and Sub-Milestones
    match /contracts/{contractId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(contractId) && isValidContract(incoming());
      allow update: if isSignedIn() && isValidId(contractId) && isValidContract(incoming()) &&
        incoming().id == existing().id &&
        incoming().clientId == existing().clientId &&
        incoming().freelancerId == existing().freelancerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scopeSummary']);
      allow delete: if false;

      match /milestones/{milestoneId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(milestoneId) && isValidMilestone(incoming());
        allow update: if isSignedIn() && isValidId(milestoneId) && isValidMilestone(incoming()) &&
          existing().state != 'ApprovedReleased' && // Terminal state locking
          incoming().id == existing().id &&
          incoming().contractId == existing().contractId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'state', 'title', 'contractValueMinor', 'reviewWindowDays',
            'fundedAt', 'submittedAt', 'reviewDeadlineAt', 'releasedAt'
          ]);
        allow delete: if false;
      }
    }

    // Rules for Ledger Entries
    match /ledgerEntries/{entryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId) && isValidLedgerEntry(incoming());
      allow update, delete: if false; // Append-only ledger
    }
  }
}
