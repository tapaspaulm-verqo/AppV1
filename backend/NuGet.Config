<?xml version="1.0" encoding="utf-8"?>
<!--
  This sandbox's network egress does not reach api.nuget.org (same class of
  restriction as several other package registries in this environment).
  Clearing package sources lets `dotnet restore`/`build` succeed for any
  project that needs no external NuGet packages (Verqo.Domain, and the
  dependency-free parts of Verqo.Application). Projects that genuinely need
  NuGet packages (EF Core/Npgsql in Verqo.Infrastructure, ASP.NET Core extras
  and JWT auth in Verqo.Api, xunit in the test project) are still written as
  normal, idiomatic .csproj files with PackageReference entries — they will
  restore and build normally the moment this runs somewhere with NuGet
  access (any normal dev machine or CI runner). Delete or edit this file
  once that's the case.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
